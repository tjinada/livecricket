# Environment
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/livecricket

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cricket123

# Mock Data
# Set to 'true' to seed database with mock data on startup
# Set to 'false' or remove to use real data only
USE_MOCK_DATA=false

# ESPN Mock Mode
# Set to 'true' to use mock ESPN data instead of live API calls
# Useful for testing ESPN integration without waiting for live matches
ESPN_MOCK_ENABLED=false
# Default mock scenario: live, completed, start, innings-break
ESPN_MOCK_SCENARIO=live
